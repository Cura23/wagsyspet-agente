<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.wagner.wagsyspet</groupId>
        <artifactId>wagsyspet-agente</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>agente-core</artifactId>
    <name>agente-core</name>
    <description>
        Servidor WebSocket local do agente (127.0.0.1) com as barreiras de segurança do endpoint:
        bind só em loopback, allowlist de Origin, checagem de Host. Protocolo do PDV (hello/ping/imprimir).
    </description>

    <dependencies>
        <dependency>
            <groupId>br.com.wagner.wagsyspet</groupId>
            <artifactId>agente-impressao</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- F3: ticket Ed25519 (VerificadorTicket) e versão do protocolo — o core fala o contrato, não só transporta -->
        <dependency>
            <groupId>br.com.wagner.wagsyspet</groupId>
            <artifactId>agente-protocolo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Binding só nos TESTES deste módulo (console). O binário usa slf4j-jdk14 → arquivo rotativo (agente-app, F3 D19);
             dois bindings no classpath = aviso do SLF4J e log em lugar errado. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Host de desenvolvimento: ./mvnw -pl agente-core -am -DskipTests compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>br.com.wagner.wagsyspet.agente.core.AgenteMain</mainClass>
                    <classpathScope>runtime</classpathScope>
                    <!-- sem jar não há MANIFEST: a versão de dev vem daqui (nunca "dev" — ver VersaoDoBinario) -->
                    <systemProperties>
                        <systemProperty>
                            <key>agente.versao</key>
                            <value>${project.version}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
